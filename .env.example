# Порт сервера
PORT=3000

# Подключение к PostgreSQL (для облачного хостинга).
# Если заполнено — заявки хранятся в БД (не теряются). Если пусто — в файле data/requests.json.
# Пример: postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Уведомления в Telegram (необязательно). Чтобы включить:
# 1. Напиши боту @BotFather -> /newbot -> получи токен
# 2. Узнай свой chat_id (например, отправив боту сообщение,
#    потом запросив https://api.telegram.org/bot<ТОКЕН>/getUpdates)
# Если не заполнено — уведомления отключаются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Пароль для входа в админку (заявки). Совместимость со старым режимом.
ADMIN_PASSWORD=change-me

# Пользователи админки (логин:пароль:роль; ...). Роль: admin (полный) или view (просмотр).
# Пример: admin:secret123:admin;pomoshnik:helper456:view
ADMIN_USERS=

# Уведомления на email о новых заявках (необязательно).
# Для Яндекса:
#   MAIL_USER = ваш ящик, например mymail@yandex.ru
#   MAIL_PASS = "пароль приложения" (создаётся в настройках Яндекса,
#               обычный пароль для внешних программ не подходит)
#   MAIL_TO   = кому слать уведомления (можно тот же адрес)
# Если пусто — email-уведомления отключены.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_TO=